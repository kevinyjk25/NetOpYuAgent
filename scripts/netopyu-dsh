run_e2e() {
  # The retirement gate must run from a clean checkout in CI. It validates
  # the plugin and bridge directly and does not require an installed DSH Web
  # runtime, settings file, Ollama model, or live network endpoint.
  check_node && check_python || return 1
  runtime_env
  cd "$PROJECT_ROOT" || return 1
  printf '1/7 Python full suite\n'
  "$PYTHON_BIN" -m pytest -q || return 1
  printf '2/7 Static audits\n'
  "$PYTHON_BIN" scripts/audit_harness_boundary.py || return 1
  printf '3/7 Node/plugin syntax\n'
  local plugin_source
  for plugin_source in dsh-plugin-netopyu/src/*.js dsh-plugin-l1-shadow-capture/src/*.js dsh-plugin-l1-protocol-controller/src/*.js; do
    node --check "$plugin_source" || return 1
  done
  node dsh-plugin-l1-shadow-capture/test/capture-smoke.mjs || return 1
  node dsh-plugin-l1-protocol-controller/test/controller-smoke.mjs || return 1
  printf '4/7 Tool, HITL, A2A, memory and trajectory smoke\n'
  NETOPYU_DSH_BACKEND=mock node dsh-plugin-netopyu/test/hitl-smoke.mjs || return 1
  NETOPYU_DSH_BACKEND=mock node dsh-plugin-netopyu/test/workflow-smoke.mjs || return 1
  printf '5/7 Profile skill projection\n'
  for profile_id in default lan dc wan; do
    NETOPYU_DSH_BACKEND=mock "$PYTHON_BIN" -m dsh_adapter.cli skill-manifest \
      --profile "$profile_id" <<<'{}' | "$PYTHON_BIN" -c '
import json, sys
r = json.load(sys.stdin)
skills = r.get("skills", [])
if not skills or len({s["name"] for s in skills}) != len(skills):
    raise SystemExit(1)
print("  PASS {}: {} skills".format(r["profile"], len(skills)))
' || return 1
  done
  printf '6/7 Retrieval retirement gate\n'
  run_parity || return 1
  printf '7/7 Local load, chaos, policy and harness-boundary retirement checks\n'
  run_reliability || return 1
  printf '\nNetOpYu DSH end-to-end offline suite: PASS\n'
}

command="${1:-}"
case "$command" in
  install) install_runtime ;;
  doctor) doctor ;;
  start) start_background ;;
  foreground) run_foreground ;;
  stop) stop_background ;;
  restart) stop_background && start_background ;;
  status) show_status ;;
  worker-start) start_worker ;;
  worker-stop) stop_worker ;;
  worker-status) show_worker_status ;;
  dc-peer-start) start_local_dc_peer ;;
  dc-peer-stop) stop_local_dc_peer ;;
  dc-peer-status) show_local_dc_peer_status ;;
  logs) mkdir -p "$LOG_DIR"; touch "$LOG_FILE"; exec tail -n 100 -f "$LOG_FILE" ;;
  dump-config) dump_config ;;
  models) show_models ;;
  model) set_default_model "$@" ;;
  preset) set_default_preset "$@" ;;
  settings-sync) check_python && write_settings ;;
  backend) show_backend ;;
  runtime-list) show_runtime_plans "$@" ;;
  runtime) show_runtime_plan "$@" ;;
  runtime-audit) audit_runtime_plan "$@" ;;
  l0-skills) show_l0_skills ;;
  demo-l1-l0) run_l1_l0_demo ;;
  peers) show_peers ;;
  parity) run_parity ;;
  learning-mine) run_learning_mine "$@" ;;
  learning-review) run_learning_review "$@" ;;
  reliability) run_reliability ;;
  compare-runtime) run_runtime_comparison "$@" ;;
  compare-l1) run_l1_comparison "$@" ;;
  compare-l1-dsh) run_l1_dsh_shadow "$@" ;;
  compare-l1-dsh-tools) run_l1_dsh_tool_shadow "$@" ;;
  compare-l1-dsh-controlled) run_l1_dsh_controlled "$@" ;;
  compare-l1-dsh-guarded) run_l1_dsh_guarded "$@" ;;
  retirement) run_e2e ;;
  e2e) run_e2e ;;
  help|-h|--help|'') usage ;;
  *) usage >&2; fail "Unknown command: $command" ;;
esac
