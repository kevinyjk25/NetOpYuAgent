# Tool-compliance golden set — 18 starter cases.
#
# Format: JSONL, one ToolCallCase per line.
# See evaluation/tool_compliance_types.py for the schema.
#
# Coverage strategy:
#   - Destructive vs read-only tools (HITL path vs non-HITL path)
#   - Single-target vs multi-target (batch executor path)
#   - English + Chinese paraphrases (script + tokenization sensitivity)
#   - Ambiguous queries (acceptable_tools — multiple right answers)
#   - Negative arg checks (forbidden_args — model hallucinating extras)
#   - Cases where the right value is query-dependent (expected_args value=null)
#
# Use this for A/B comparing native-tools vs text-protocol on the
# SAME query set. Native should boost args_ok dramatically; parse_ok
# and name_ok deltas tell you about prompt-engineering effects.
#
# Lines starting with "#" are skipped by the loader.
{"query": "restart nginx on web-01", "expected_tool": "restart_service", "expected_args": {"device_id": "web-01", "service": "nginx"}, "tags": ["destructive", "single"]}
{"query": "show interface status on switch-7", "expected_tool": "get_interface_status", "expected_args": {"device_id": "switch-7"}, "tags": ["readonly", "single"]}
{"query": "set radius-server timeout to 3 on ap-01", "expected_tool": "edit_device_config", "expected_args": {"device_id": "ap-01", "config_lines": ["radius-server timeout 3"]}, "tags": ["destructive", "single"]}
{"query": "ping 10.1.0.5 from router-3 with 5 packets", "expected_tool": "ping_from_device", "expected_args": {"device_id": "router-3", "target": "10.1.0.5", "count": 5}, "tags": ["readonly", "single", "numeric"]}
{"query": "what's the cpu load on fw-east?", "expected_tool": "get_device_status", "expected_args": {"device_id": "fw-east"}, "acceptable_tools": ["query_interface_metrics"], "tags": ["readonly", "ambiguous"]}
{"query": "查询设备 ap-02 的接口状态", "expected_tool": "get_interface_status", "expected_args": {"device_id": "ap-02"}, "language": "zh", "tags": ["readonly", "single"]}
{"query": "重启 web-04 上的 redis 服务", "expected_tool": "restart_service", "expected_args": {"device_id": "web-04", "service": "redis"}, "language": "zh", "tags": ["destructive", "single"]}
{"query": "把 ap-01 和 ap-02 的 radius timeout 都改成 3", "expected_tool": "edit_device_config", "expected_args": {"device_id": null, "config_lines": ["radius-server timeout 3"]}, "required_arg_names": ["device_id", "config_lines"], "language": "zh", "tags": ["destructive", "multi-target"], "notes": "device_id may be ap-01 OR ap-02 — bench checks presence, batch executor handles fan-out"}
{"query": "diagnose unusual login failures on the auth-server", "expected_tool": "service_health", "acceptable_tools": ["syslog_search", "get_service_logs"], "expected_args": {"device_id": "auth-server"}, "required_arg_names": ["device_id"], "tags": ["readonly", "ambiguous"]}
{"query": "回滚 router-12 的最近一次配置变更", "expected_tool": "rollback_config", "expected_args": {"device_id": "router-12"}, "language": "zh", "tags": ["destructive", "single"]}
{"query": "list all currently dormant skills", "expected_tool": "list_dormant_skills", "expected_args": {}, "tags": ["meta", "no-args"]}
{"query": "what changed on fw-east since yesterday?", "expected_tool": "get_change_log", "expected_args": {"device_id": "fw-east"}, "required_arg_names": ["device_id"], "tags": ["readonly", "temporal"]}
{"query": "shutdown interface GigabitEthernet0/1 on switch-7 — maintenance window starts now", "expected_tool": "edit_device_config", "expected_args": {"device_id": "switch-7", "config_lines": ["interface GigabitEthernet0/1", "shutdown"]}, "forbidden_args": ["password", "credentials", "force"], "tags": ["destructive", "single", "anti-hallucination"]}
{"query": "search syslog on log-aggregator for 'OSPF neighbor down' in last 4 hours", "expected_tool": "syslog_search", "expected_args": {"device_id": "log-aggregator", "pattern": "OSPF neighbor down"}, "required_arg_names": ["device_id", "pattern"], "tags": ["readonly", "string-value"]}
{"query": "trace route to 8.8.8.8 from edge-router-1", "expected_tool": "traceroute_from_device", "expected_args": {"device_id": "edge-router-1", "target": "8.8.8.8"}, "tags": ["readonly", "single"]}
{"query": "请帮我看一下 db-master 的健康状况", "expected_tool": "service_health", "acceptable_tools": ["get_device_status"], "expected_args": {"device_id": "db-master"}, "language": "zh", "tags": ["readonly", "ambiguous"]}
{"query": "push these config lines to core-sw: 'spanning-tree mode rapid-pvst', 'no spanning-tree vlan 999'", "expected_tool": "edit_device_config", "expected_args": {"device_id": "core-sw", "config_lines": ["spanning-tree mode rapid-pvst", "no spanning-tree vlan 999"]}, "tags": ["destructive", "single", "multi-line"]}
{"query": "show running config of router-3", "expected_tool": "get_running_config", "acceptable_tools": ["get_device_config"], "expected_args": {"device_id": "router-3"}, "tags": ["readonly", "single"]}
