  report="$(cd "$PROJECT_ROOT" && "$PYTHON_BIN" -m dsh_adapter.cli reliability \
    --project-root "$PROJECT_ROOT" --python "$PYTHON_BIN" --requests 24 --concurrency 8)" || return 1
  printf '%s' "$report" | "$PYTHON_BIN" -m json.tool
  printf '%s' "$report" | "$PYTHON_BIN" -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin).get("ok") else 1)'
}

