#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PYTHON_BIN="${NETOPYU_PYTHON:-$PROJECT_ROOT/.venv/bin/python}"

[[ -x "$PYTHON_BIN" ]] || {
  printf 'ERROR: project Python is missing: %s\n' "$PYTHON_BIN" >&2
  exit 1
}

cd "$PROJECT_ROOT"
exec "$PYTHON_BIN" -m evaluation.harness_skill_runtime_ab "$@"
