run_learning_mine() {
  check_python || return 1
  runtime_env
  cd "$PROJECT_ROOT" || return 1
  if [[ "${2:-}" == "--apply" ]]; then
    "$PYTHON_BIN" -m dsh_adapter.cli trajectory-mine \
      --source "$HITL_STORE" --database "$LEARNING_STORE" --apply \
      | "$PYTHON_BIN" -m json.tool
  else
    "$PYTHON_BIN" -m dsh_adapter.cli trajectory-mine \
      --source "$HITL_STORE" --database "$LEARNING_STORE" \
      | "$PYTHON_BIN" -m json.tool
  fi
}

run_learning_review() {
  check_python || return 1
  local candidate="${2:-}" decision="${3:-}" reviewer="${4:-}"
  [[ -n "$candidate" && -n "$decision" && -n "$reviewer" ]] || {
    fail 'Usage: scripts/netopyu-dsh learning-review ID approve|reject REVIEWER'; return 1;
  }
  if [[ "$decision" == "approve" ]]; then
    "$PYTHON_BIN" -m dsh_adapter.cli trajectory-review \
      --database "$LEARNING_STORE" --candidate "$candidate" \
      --decision "$decision" --reviewer "$reviewer" \
      --proposal-directory "$LEARNING_PROPOSALS" | "$PYTHON_BIN" -m json.tool
  else
    "$PYTHON_BIN" -m dsh_adapter.cli trajectory-review \
      --database "$LEARNING_STORE" --candidate "$candidate" \
      --decision "$decision" --reviewer "$reviewer" | "$PYTHON_BIN" -m json.tool
  fi
}

